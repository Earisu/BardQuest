<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BardQuest.Updater"
        xmlns:disc="clr-namespace:BardQuest.Updater.Core.Discovery;assembly=BardQuest.Updater.Core"
        x:Class="BardQuest.Updater.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="560" Height="575"
        Title="BardQuest Updater"
        Icon="/Assets/BardQuest-logo.png"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24" Spacing="14">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Image Source="/Assets/BardQuest-logo.png" Width="52" Height="52"
             VerticalAlignment="Center" />
      <TextBlock Text="BardQuest" FontSize="28" FontWeight="Bold"
                 VerticalAlignment="Center" />
    </StackPanel>

    <TextBlock Text="YARG installation" FontWeight="SemiBold" />
    <ComboBox ItemsSource="{Binding Installs}"
              SelectedItem="{Binding SelectedInstall, Mode=TwoWay}"
              HorizontalAlignment="Stretch"
              PlaceholderText="Select a YARG install">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="disc:YargInstall">
          <TextBlock Text="{Binding Label}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Rescan" Click="OnRescan" />
      <Button Content="Choose folder…" Click="OnChooseFolder" />
    </StackPanel>

    <Border Background="#20FFFFFF" CornerRadius="4" Padding="10">
      <StackPanel Spacing="4">
        <TextBlock Text="Selected Managed folder:" Opacity="0.7" FontSize="12" />
        <TextBlock Text="{Binding ManagedDir}" TextWrapping="Wrap" FontFamily="monospace" />
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.8" />

    <Border Height="1" Background="#30FFFFFF" Margin="0,4" />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Install" Click="OnInstall" IsEnabled="{Binding CanAct}" />
      <Button Content="Update" Click="OnUpdate" IsEnabled="{Binding CanAct}" />
      <Button Content="Check for updates" Click="OnCheck" IsEnabled="{Binding CanAct}" />
      <Button Content="Remove" Click="OnRemove" IsEnabled="{Binding CanAct}" />
    </StackPanel>

    <StackPanel Spacing="2">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Text="Installed:" Opacity="0.7" FontSize="12" />
        <TextBlock Text="{Binding InstalledDisplay}" Opacity="0.7" FontSize="12" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Text="Latest available:" Opacity="0.7" FontSize="12" />
        <TextBlock Text="{Binding CandidateDisplay}" Opacity="0.7" FontSize="12" />
      </StackPanel>
    </StackPanel>

    <CheckBox Content="Keep BardQuest up to date automatically (runs at login)"
              IsChecked="{Binding AutoUpdateEnabled, Mode=TwoWay}" />
  </StackPanel>
</Window>
