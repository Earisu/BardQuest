<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BardQuest.Updater.MainWindow"
        Width="520" Height="360"
        Title="BardQuest Updater"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Text="BardQuest" FontSize="28" FontWeight="Bold" />
    <TextBlock Text="Installer and updater" Opacity="0.7" />
  </StackPanel>
</Window>
